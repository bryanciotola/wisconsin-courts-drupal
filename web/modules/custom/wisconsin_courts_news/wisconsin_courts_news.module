<?php

/**
 * @file
 * Publishing behavior and PIO dashboard styling for News and Opinions.
 */

use Drupal\Component\Render\FormattableMarkup;
use Drupal\Core\Form\FormStateInterface;
use Drupal\datetime\Plugin\Field\FieldType\DateTimeItemInterface;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_node_presave().
 *
 * Automatically assigns a publication date the first time
 * a News story or Opinion is published.
 */
function wisconsin_courts_news_node_presave(NodeInterface $node): void {

  $supported_types = [
    'news_story',
    'opinion',
  ];

  // Only run for News stories and Opinions.
  if (!in_array($node->bundle(), $supported_types, TRUE)) {
    return;
  }

  // Confirm that the publication date field exists.
  if (!$node->hasField('field_publication_date')) {
    return;
  }

  // Unpublished content does not receive a new date.
  if (!$node->isPublished()) {
    return;
  }

  // Never overwrite an existing publication date.
  if (!$node->get('field_publication_date')->isEmpty()) {
    return;
  }

  // Assign the first publication date in UTC.
  $node->set(
    'field_publication_date',
    gmdate(
      DateTimeItemInterface::DATETIME_STORAGE_FORMAT,
      \Drupal::time()->getRequestTime()
    )
  );
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 *
 * Adds document validation to the Opinion editing form.
 */
function wisconsin_courts_news_form_node_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id
): void {

  $node = $form_state->getFormObject()->getEntity();

  // Only add this validation to Opinion forms.
  if (!$node instanceof NodeInterface || $node->bundle() !== 'opinion') {
    return;
  }

  $form['#validate'][] = 'wisconsin_courts_news_validate_opinion';
}

/**
 * Validates document sources when publishing an Opinion.
 */
function wisconsin_courts_news_validate_opinion(
  array &$form,
  FormStateInterface $form_state
): void {

  // Build the Opinion with the submitted form values.
  $node = $form_state->getFormObject()->buildEntity($form, $form_state);

  // Allow incomplete unpublished drafts.
  if (!$node->isPublished()) {
    return;
  }

  $has_document = !$node->get('field_opinion_document')->isEmpty();
  $has_url = !$node->get('field_opinion_url')->isEmpty();

  // A published Opinion must have a document or URL.
  if (!$has_document && !$has_url) {
    $form_state->setErrorByName(
      'field_opinion_document',
      t('Please upload an Opinion document or enter an Opinion URL before publishing.')
    );
  }

  // Do not allow both sources at the same time.
  if ($has_document && $has_url) {
    $form_state->setErrorByName(
      'field_opinion_url',
      t('Please provide either an Opinion document or an Opinion URL, not both.')
    );
  }
}

/**
 * Implements hook_views_pre_render().
 *
 * Loads the stylesheet for the PIO dashboard.
 */
function wisconsin_courts_news_views_pre_render(
  ViewExecutable $view
): void {

  if ($view->id() !== 'pio_content_dashboard') {
    return;
  }

  $view->element['#attached']['library'][] =
    'wisconsin_courts_news/pio-dashboard';
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Adds the CSS class used by the dashboard stylesheet.
 */
function wisconsin_courts_news_preprocess_views_view(
  array &$variables
): void {

  if ($variables['view']->id() !== 'pio_content_dashboard') {
    return;
  }

  $variables['attributes']['class'][] = 'pio-dashboard';
}

/**
 * Implements hook_preprocess_views_view_field().
 *
 * Displays publication status as a badge.
 */
function wisconsin_courts_news_preprocess_views_view_field(
  array &$variables
): void {

  if (
    $variables['view']->id() !== 'pio_content_dashboard' ||
    $variables['field']->field !== 'status'
  ) {
    return;
  }

  $node = $variables['row']->_entity ?? NULL;

  if (!$node instanceof NodeInterface) {
    return;
  }

  $published = $node->isPublished();

  $variables['output'] = new FormattableMarkup(
    '<span class="pio-status pio-status--@state">@label</span>',
    [
      '@state' => $published ? 'published' : 'unpublished',
      '@label' => $published ? t('Published') : t('Unpublished'),
    ]
  );
}

/**
 * Implements hook_preprocess_HOOK() for the Navigation menu.
 *
 * Gives the "View website" menu item Drupal's eye icon.
 */
function wisconsin_courts_news_preprocess_navigation_menu(
  array &$variables
): void {

  // The ID of the "View website" menu link created in the Drupal UI.
  $link_id = 'menu_link_content:0f5b9122-d995-49d5-ac55-6fba7dee2751';

  // Only change this link when it exists in the menu being rendered.
  if (!isset($variables['items'][$link_id])) {
    return;
  }

  // Use the eye icon from Drupal's Navigation icon pack.
  $variables['items'][$link_id]['icon'] = [
    'pack_id' => 'navigation',
    'icon_id' => 'eye',
    'settings' => [
      'class' => 'toolbar-button__icon',
      'size' => 20,
    ],
  ];
}