{% set sprite_path = base_path ~ 'themes/custom/wisconsin_courts/assets/uswds/images/sprite.svg' %}

{% set tasks = [
  {
    title: task_1_title,
    description: task_1_description,
    url: task_1_url,
    icon: 'account_balance'
  },
  {
    title: task_2_title,
    description: task_2_description,
    url: task_2_url,
    icon: 'account_box'
  },
  {
    title: task_3_title,
    description: task_3_description,
    url: task_3_url,
    icon: 'do_not_disturb'
  },
  {
    title: task_4_title,
    description: task_4_description,
    url: task_4_url,
    icon: 'topic'
  },
  {
    title: task_5_title,
    description: task_5_description,
    url: task_5_url,
    icon: 'groups'
  },
  {
    title: task_6_title,
    description: task_6_description,
    url: task_6_url,
    icon: 'attach_money'
  }
] %}

<div class="wc-popular-tasks-wrapper">

  <aside
    class="
      wc-popular-tasks
      bg-primary-lighter
      radius-md
    "
  >

    <h2 class="wc-popular-tasks__heading">
      {{ heading|default('Popular tasks') }}
    </h2>

    <div class="wc-popular-tasks__list">

      {% for item in tasks %}

        {% if item.title %}

          <a
            href="{{ item.url|default('#') }}"
            class="
              wc-popular-tasks__item
              text-no-underline
              {% if not loop.last %}
                border-bottom
                border-base-lighter
              {% endif %}
            "
          >

            <span
              class="
                wc-popular-tasks__icon
                text-primary
              "
              aria-hidden="true"
            >
              <svg
                class="usa-icon usa-icon--size-5"
                aria-hidden="true"
                focusable="false"
                role="img"
              >
                <use href="{{ sprite_path }}#{{ item.icon }}"></use>
              </svg>
            </span>

            <span class="wc-popular-tasks__content">

              <span class="wc-popular-tasks__title">
                {{ item.title }}
              </span>

              {% if item.description %}

                <span class="wc-popular-tasks__description">
                  {{ item.description }}
                </span>

              {% endif %}

            </span>

            <span
              class="wc-popular-tasks__arrow text-primary"
              aria-hidden="true"
            >
              ›
            </span>

          </a>

        {% endif %}

      {% endfor %}

    </div>

  </aside>

</div>