{% set sprite_path = base_path ~ 'themes/custom/wisconsin_courts/assets/uswds/images/sprite.svg' %}

{% set specialized_searches = [
  {
    text: specialized_1_text,
    url: specialized_1_url
  },
  {
    text: specialized_2_text,
    url: specialized_2_url
  },
  {
    text: specialized_3_text,
    url: specialized_3_url
  },
  {
    text: specialized_4_text,
    url: specialized_4_url
  }
] %}

{% set actions = [
  {
    title: action_1_title,
    description: action_1_description,
    url: action_1_url,
    icon: 'fees'
  },
  {
    title: action_2_title,
    description: action_2_description,
    url: action_2_url,
    icon: 'live'
  },
  {
    title: action_3_title,
    description: action_3_description,
    url: action_3_url,
    icon: 'clerk'
  },
  {
    title: action_4_title,
    description: action_4_description,
    url: action_4_url,
    icon: 'efile'
  }
] %}

{% set audiences = [
  {
    text: audience_1_text,
    url: audience_1_url,
    icon: 'person'
  },
  {
    text: audience_2_text,
    url: audience_2_url,
    icon: 'groups'
  },
  {
    text: audience_3_text,
    url: audience_3_url,
    icon: 'work'
  },
  {
    text: audience_4_text,
    url: audience_4_url,
    icon: 'account_balance'
  },
  {
    text: audience_5_text,
    url: audience_5_url,
    icon: 'forum'
  }
] %}

<section
  class="wc-homepage-hero"
  {% if background_image %}
    style="--wc-homepage-hero-image: url('{{ background_image }}');"
  {% endif %}
>

  <div class="grid-container wc-homepage-hero__inner">

    <div class="wc-homepage-hero__content">

      {% if heading %}

        <h1 class="wc-homepage-hero__heading">
          {{ heading }}
        </h1>

      {% endif %}

      {% if intro_text %}

        <p class="wc-homepage-hero__intro">
          {{ intro_text }}
        </p>

      {% endif %}

      <div class="wc-homepage-hero__search-area">

        <form
          action="{{ search_action|default('#') }}"
          method="get"
          class="wc-homepage-hero__search-form"
        >

          <label
            class="usa-sr-only"
            for="homepage-search"
          >
            Search Wisconsin Courts
          </label>

          <div class="wc-homepage-hero__search">

            <input
              id="homepage-search"
              type="search"
              name="search"
              class="wc-homepage-hero__search-input"
            >

            <button
              class="usa-button wc-homepage-hero__search-button"
              type="submit"
            >

              <span>
                {{ search_button_text|default('Search') }}
              </span>

              <svg
                aria-hidden="true"
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
              >
                <circle
                  cx="11"
                  cy="11"
                  r="7"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="M16.5 16.5L21 21"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>

            </button>

          </div>

        </form>

        <div class="wc-homepage-hero__specialized">

          {% if specialized_label %}

            <div
              class="
                wc-homepage-hero__specialized-label
                font-sans-3xs
                text-primary
                text-bold
              "
            >
              {{ specialized_label }}
            </div>

          {% endif %}

          <div class="wc-homepage-hero__specialized-links">

            {% for item in specialized_searches %}

              {% if item.text and item.url %}

                <a
                  href="{{ item.url }}"
                  class="
                    wc-homepage-hero__specialized-link
                    bg-white
                    border
                    border-base-lighter
                    radius-sm
                    text-primary
                    text-semibold
                    text-no-underline
                    font-sans-3xs
                  "
                >
                  {{ item.text }}
                </a>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </div>

    </div>

  </div>

</section>

<div class="grid-container wc-homepage-actions-wrapper">

  <div class="wc-homepage-actions">

    {% for action in actions %}

      {% if action.title and action.url %}

        <a
          href="{{ action.url }}"
          class="
            wc-homepage-action
            bg-white
            text-primary-darker
            text-no-underline
          "
        >

          <div
            class="
              wc-homepage-action__icon
              wc-homepage-action__icon--{{ action.icon }}
            "
            aria-hidden="true"
          >

            {% if action.icon == 'fees' %}

              <svg width="25" height="25" viewBox="0 0 24 24" fill="none">
                <rect
                  x="3"
                  y="6"
                  width="18"
                  height="13"
                  rx="2"
                  stroke="currentColor"
                  stroke-width="1.7"
                />
                <path
                  d="M7 10H17M7 14H11"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>

            {% elseif action.icon == 'live' %}

              <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                <circle
                  cx="12"
                  cy="12"
                  r="2.2"
                  fill="currentColor"
                />
                <path
                  d="M8.5 8.5C6.6 10.4 6.6 13.6 8.5 15.5M15.5 8.5C17.4 10.4 17.4 13.6 15.5 15.5M5.5 5.5C1.9 9.1 1.9 14.9 5.5 18.5M18.5 5.5C22.1 9.1 22.1 14.9 18.5 18.5"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>

            {% elseif action.icon == 'clerk' %}

              <svg width="25" height="25" viewBox="0 0 24 24" fill="none">
                <path
                  d="M12 21C12 21 18 15.7 18 10.5C18 6.9 15.3 4 12 4C8.7 4 6 6.9 6 10.5C6 15.7 12 21 12 21Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <circle
                  cx="12"
                  cy="10"
                  r="2"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
              </svg>

            {% else %}

              <svg width="25" height="25" viewBox="0 0 24 24" fill="none">
                <path
                  d="M3 7H9L11 9H21V19H3V7Z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linejoin="round"
                />
                <path
                  d="M5 5H10L12 7"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                />
              </svg>

            {% endif %}

          </div>

          <div class="wc-homepage-action__content">

            <div
              class="
                wc-homepage-action__title
                font-sans-sm
                text-bold
              "
            >
              {{ action.title }}
            </div>

            {% if action.description %}

              <div
                class="
                  wc-homepage-action__description
                  font-sans-3xs
                  text-base-dark
                "
              >
                {{ action.description }}
              </div>

            {% endif %}

          </div>

          <span
            class="
              wc-homepage-action__arrow
              text-primary
              text-bold
            "
            aria-hidden="true"
          >
            ›
          </span>

        </a>

      {% endif %}

    {% endfor %}

  </div>

</div>

<div class="grid-container wc-homepage-audience-wrapper">

  <nav
    class="
      wc-homepage-audience
      bg-primary-dark
    "
    aria-label="{{ audience_label|default('Information for') }}"
  >

    {% if audience_label %}

      <div
        class="
          wc-homepage-audience__label
          text-white
          text-bold
        "
      >
        {{ audience_label }}
      </div>

    {% endif %}

    <div class="wc-homepage-audience__links">

      {% for audience in audiences %}

        {% if audience.text and audience.url %}

          <a
            href="{{ audience.url }}"
            class="
              wc-homepage-audience__link
              text-white
              text-no-underline
            "
          >

            <span
              class="
                wc-homepage-audience__icon
                text-primary-lighter
              "
              aria-hidden="true"
            >
              <svg
                class="usa-icon wc-homepage-audience__icon-svg"
                aria-hidden="true"
                focusable="false"
                role="img"
              >
                <use href="{{ sprite_path }}#{{ audience.icon }}"></use>
              </svg>
            </span>

            <span class="wc-homepage-audience__text">
              {{ audience.text }}
            </span>

          </a>

        {% endif %}

      {% endfor %}

    </div>

  </nav>

</div>

<div class="wc-homepage-hero__after"></div>