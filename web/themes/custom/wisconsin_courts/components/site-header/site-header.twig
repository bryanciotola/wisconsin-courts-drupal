{% set utility_links = [
  { text: utility_1_text, url: utility_1_url },
  { text: utility_2_text, url: utility_2_url },
  { text: utility_3_text, url: utility_3_url },
  { text: utility_4_text, url: utility_4_url }
] %}

{% set primary_links = [
  { text: primary_1_text, url: primary_1_url },
  { text: primary_2_text, url: primary_2_url },
  { text: primary_3_text, url: primary_3_url },
  { text: primary_4_text, url: primary_4_url },
  { text: primary_5_text, url: primary_5_url },
  { text: primary_6_text, url: primary_6_url },
  { text: primary_7_text, url: primary_7_url }
] %}

<header
  style="
    position: relative;
    z-index: 20;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #dfe3e7;
  "
>

  <div class="grid-container">

    <div
      style="
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        min-height: 86px;
        padding-top: 0.8rem;
        padding-bottom: 0.65rem;
      "
    >

      <a
        href="{{ home_url|default('/') }}"
        style="
          display: inline-flex;
          align-items: center;
          flex: 0 0 auto;
          min-width: 0;
          text-decoration: none;
        "
      >

        {% if logo_image %}

          <img
            src="{{ logo_image }}"
            alt="{{ logo_alt|default(site_name|default('Wisconsin Court System')) }}"
            style="
              display: block;
              width: auto;
              max-width: 315px;
              max-height: 72px;
              object-fit: contain;
              object-position: left center;
            "
          >

        {% else %}

          <span
            style="
              color: #173f67;
              font-size: 1.6rem;
              font-weight: 700;
              white-space: nowrap;
            "
          >
            {{ site_name|default('Wisconsin Court System') }}
          </span>

        {% endif %}

      </a>

      <nav
        aria-label="Utility navigation"
        style="
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 1.35rem;
          flex: 1;
          min-width: 0;
        "
      >

        {% for item in utility_links %}
          {% if item.text and item.url %}
            <a
              href="{{ item.url }}"
              style="
                color: #274766;
                font-size: 0.82rem;
                font-weight: 600;
                line-height: 1.15;
                text-decoration: none;
                white-space: nowrap;
              "
            >
              {{ item.text }}
            </a>
          {% endif %}
        {% endfor %}

        {% if search_url %}
          <a
            href="{{ search_url }}"
            aria-label="Search"
            style="
              display: inline-flex;
              align-items: center;
              justify-content: center;
              width: 32px;
              height: 32px;
              flex: 0 0 32px;
              color: #173f67;
              text-decoration: none;
            "
          >
            <svg
              aria-hidden="true"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
            >
              <circle
                cx="11"
                cy="11"
                r="7"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M16.5 16.5L21 21"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </a>
        {% endif %}

      </nav>

    </div>

  </div>

  <div
    style="
      border-top: 1px solid #edf0f3;
      background: #ffffff;
    "
  >

    <div class="grid-container">

      <nav
        aria-label="Primary navigation"
        style="
          display: flex;
          align-items: center;
          justify-content: flex-end;
          gap: 2rem;
          width: 100%;
          min-height: 52px;
          padding-left: 1rem;
          padding-right: 1rem;
        "
      >

        {% for item in primary_links %}
          {% if item.text and item.url %}
            <a
              href="{{ item.url }}"
              style="
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex: 0 0 auto;
                padding-top: 0.9rem;
                padding-bottom: 0.9rem;
                color: #173f67;
                font-size: 0.88rem;
                font-weight: 700;
                line-height: 1.1;
                text-decoration: none;
                white-space: nowrap;
                border-bottom: 3px solid transparent;
              "
            >
              {{ item.text }}
            </a>
          {% endif %}
        {% endfor %}

      </nav>

    </div>

  </div>

</header>