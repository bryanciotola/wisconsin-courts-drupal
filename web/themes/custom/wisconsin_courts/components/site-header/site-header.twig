{% set utility_links = [
  { text: utility_1_text, url: utility_1_url },
  { text: utility_2_text, url: utility_2_url },
  { text: utility_3_text, url: utility_3_url },
  { text: utility_4_text, url: utility_4_url }
] %}

{% set primary_links = [
  { text: primary_1_text, url: primary_1_url },
  { text: primary_2_text, url: primary_2_url },
  { text: primary_3_text, url: primary_3_url },
  { text: primary_4_text, url: primary_4_url },
  { text: primary_5_text, url: primary_5_url },
  { text: primary_6_text, url: primary_6_url },
  { text: primary_7_text, url: primary_7_url }
] %}

<header
  class="
    wc-site-header
    bg-white
    border-bottom
    border-base-lighter
  "
>

  <div class="grid-container wc-site-header__container">

    <div class="wc-site-header__top">

      <a
        href="{{ home_url|default('/') }}"
        class="
          wc-site-header__brand
          text-no-underline
        "
      >

        {% if logo_image %}

          <img
            src="{{ logo_image }}"
            alt="{{ logo_alt|default(site_name|default('Wisconsin Court System')) }}"
            class="wc-site-header__logo"
          >

        {% else %}

          <span
            class="
              font-heading-lg
              text-primary-darker
              text-bold
            "
          >
            {{ site_name|default('Wisconsin Court System') }}
          </span>

        {% endif %}

      </a>


      <div class="wc-site-header__desktop-nav">

        <nav
          class="wc-site-header__utility"
          aria-label="Utility navigation"
        >

          {% for item in utility_links %}
            {% if item.text and item.url %}

              <a
                href="{{ item.url }}"
                class="
                  text-primary-darker
                  text-semibold
                  text-no-underline
                "
              >
                {{ item.text }}
              </a>

            {% endif %}
          {% endfor %}

          {% if search_url %}

            <a
              href="{{ search_url }}"
              aria-label="Search"
              class="
                wc-site-header__search
                text-primary-darker
                text-no-underline
              "
            >
              <svg
                aria-hidden="true"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
              >
                <circle
                  cx="11"
                  cy="11"
                  r="7"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="M16.5 16.5L21 21"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            </a>

          {% endif %}

        </nav>


        <nav
          class="wc-site-header__primary"
          aria-label="Primary navigation"
        >

          {% for item in primary_links %}
            {% if item.text and item.url %}

              <a
                href="{{ item.url }}"
                class="
                  text-primary-darker
                  text-no-underline
                "
              >
                {{ item.text }}
              </a>

            {% endif %}
          {% endfor %}

        </nav>

      </div>


      <button
        class="
          wc-site-header__menu-button
          usa-button
          usa-button--unstyled
          text-primary-darker
          text-bold
        "
        type="button"
        aria-expanded="false"
        aria-controls="wc-site-header-mobile-nav"
      >
        <span class="wc-site-header__menu-label">Menu</span>

        <svg
          aria-hidden="true"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M4 7H20M4 12H20M4 17H20"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />
        </svg>
      </button>

    </div>

  </div>


  <div
    id="wc-site-header-mobile-nav"
    class="
      wc-site-header__mobile-nav
      border-top
      border-base-lighter
      bg-white
    "
    hidden
  >

    <div class="grid-container">

      <nav aria-label="Mobile navigation">

        <div class="wc-site-header__mobile-primary">

          {% for item in primary_links %}
            {% if item.text and item.url %}

              <a
                href="{{ item.url }}"
                class="
                  wc-site-header__mobile-link
                  font-sans-sm
                  text-primary-darker
                  text-bold
                  text-no-underline
                  border-bottom
                  border-base-lighter
                "
              >
                {{ item.text }}
                <span aria-hidden="true">›</span>
              </a>

            {% endif %}
          {% endfor %}

        </div>

        <div class="wc-site-header__mobile-utility">

          {% for item in utility_links %}
            {% if item.text and item.url %}

              <a
                href="{{ item.url }}"
                class="
                  wc-site-header__mobile-utility-link
                  font-sans-xs
                  text-primary-darker
                  text-no-underline
                "
              >
                {{ item.text }}
              </a>

            {% endif %}
          {% endfor %}

          {% if search_url %}

            <a
              href="{{ search_url }}"
              class="
                wc-site-header__mobile-utility-link
                font-sans-xs
                text-primary-darker
                text-semibold
                text-no-underline
              "
            >
              Search
            </a>

          {% endif %}

        </div>

      </nav>

    </div>

  </div>

</header>