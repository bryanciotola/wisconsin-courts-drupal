{# Fixed styles live beside this template; alert content stays in block configuration. #}
<div
  role="status"
  class="wc-site-alert"
>
  <div
    class="grid-container wc-site-alert__inner"
  >

    <span
      aria-hidden="true"
      class="wc-site-alert__icon"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
      >
        <path
          d="M12 3L22 20H2L12 3Z"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linejoin="round"
        />
        <path
          d="M12 9V14"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
        <circle
          cx="12"
          cy="17"
          r="1"
          fill="currentColor"
        />
      </svg>
    </span>

    {% if alert_text %}
      <span>
        {{ alert_text }}
      </span>
    {% endif %}

    {% if alert_link_text and alert_link_url %}
      <a
        href="{{ alert_link_url }}"
        class="wc-site-alert__link"
      >
        {{ alert_link_text }}
      </a>
    {% endif %}

  </div>
</div>