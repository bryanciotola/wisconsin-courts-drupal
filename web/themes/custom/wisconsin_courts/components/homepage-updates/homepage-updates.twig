{% set news_items = [
  {
    title: news_1_title,
    date: news_1_date,
    url: news_1_url
  },
  {
    title: news_2_title,
    date: news_2_date,
    url: news_2_url
  },
  {
    title: news_3_title,
    date: news_3_date,
    url: news_3_url
  }
] %}

{% set task_items = [
  {
    text: task_1_text,
    url: task_1_url
  },
  {
    text: task_2_text,
    url: task_2_url
  },
  {
    text: task_3_text,
    url: task_3_url
  },
  {
    text: task_4_text,
    url: task_4_url
  },
  {
    text: task_5_text,
    url: task_5_url
  }
] %}

<section class="bg-white padding-y-7">

  <div class="grid-container">

    <div class="grid-row grid-gap-6">

      {# -----------------------------------------
         Latest news and opinions
      ------------------------------------------ #}

      <div class="tablet:grid-col-8">

        <h2
          class="
            font-heading-xl
            text-primary-darker
            text-bold
            margin-top-0
            margin-bottom-3
          "
        >
          {{ news_heading|default('Latest news and opinions') }}
        </h2>

        <div class="border-top border-base-lighter">

          {% for item in news_items %}

            {% if item.title and item.url %}

              <article
                class="
                  grid-row
                  grid-gap-2
                  padding-y-3
                  border-bottom
                  border-base-lighter
                "
              >

                <div
                  class="
                    tablet:grid-col-3
                    text-base
                    font-sans-2xs
                    text-bold
                    text-uppercase
                  "
                >
                  {{ item.date }}
                </div>

                <div class="tablet:grid-col-9">

                  <a
                    href="{{ item.url }}"
                    class="
                      text-primary
                      text-bold
                      text-no-underline
                    "
                  >
                    {{ item.title }}
                  </a>

                </div>

              </article>

            {% endif %}

          {% endfor %}

        </div>

        {% if news_more_text and news_more_url %}

          <div class="margin-top-3">

            <a
              href="{{ news_more_url }}"
              class="
                display-inline-flex
                flex-align-center
                text-primary
                text-bold
                text-no-underline
              "
            >

              <span>
                {{ news_more_text }}
              </span>

              <svg
                aria-hidden="true"
                class="margin-left-1"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
              >

                <path
                  d="M5 12H19"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />

                <path
                  d="M13 6L19 12L13 18"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

              </svg>

            </a>

          </div>

        {% endif %}

      </div>

      {# -----------------------------------------
         Popular tasks
      ------------------------------------------ #}

      <aside class="tablet:grid-col-4">

        <div
          class="
            bg-base-lightest
            border
            border-base-lighter
            radius-md
            padding-4
          "
        >

          <h2
            class="
              font-heading-lg
              text-primary-darker
              text-bold
              margin-top-0
              margin-bottom-3
            "
          >
            {{ tasks_heading|default('Popular tasks') }}
          </h2>

          <div>

            {% for item in task_items %}

              {% if item.text and item.url %}

                <a
                  href="{{ item.url }}"
                  class="
                    display-flex
                    flex-align-center
                    flex-justify
                    text-primary
                    text-bold
                    text-no-underline
                    padding-y-2
                    border-top
                    border-base-lighter
                  "
                >

                  <span>
                    {{ item.text }}
                  </span>

                  <svg
                    aria-hidden="true"
                    class="flex-no-shrink margin-left-2"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                  >

                    <path
                      d="M9 6L15 12L9 18"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />

                  </svg>

                </a>

              {% endif %}

            {% endfor %}

          </div>

        </div>

      </aside>

    </div>

  </div>

</section>