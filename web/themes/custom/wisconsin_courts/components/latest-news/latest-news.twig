{% set news_items = [
  {
    date: news_1_date,
    title: news_1_title,
    url: news_1_url
  },
  {
    date: news_2_date,
    title: news_2_title,
    url: news_2_url
  },
  {
    date: news_3_date,
    title: news_3_title,
    url: news_3_url
  }
] %}

<section class="wc-latest-news">

  <h2 class="wc-latest-news__heading">
    {{ heading|default('Latest news and opinions') }}
  </h2>

  <div class="wc-latest-news__nav">

    <div
      class="wc-latest-news__tabs"
      aria-label="News categories"
    >

      <span class="wc-latest-news__tab wc-latest-news__tab--active">
        News
      </span>

      <span class="wc-latest-news__tab">
        Opinions
      </span>

      <span class="wc-latest-news__tab">
        Both
      </span>

    </div>

    {% if all_news_text and all_news_url %}

      <a
        href="{{ all_news_url }}"
        class="wc-latest-news__view-all"
      >
        {{ all_news_text }}
        <span aria-hidden="true">›</span>
      </a>

    {% endif %}

  </div>

  {% if featured_title %}

    <article class="wc-latest-news__featured">

      <div class="wc-latest-news__featured-image-wrapper">

        {% if featured_image %}

          <img
            src="{{ featured_image }}"
            alt="{{ featured_image_alt|default('') }}"
            class="wc-latest-news__featured-image"
          >

        {% endif %}

      </div>

      <div class="wc-latest-news__featured-content">

        {% if featured_label %}

          <div class="wc-latest-news__badge-wrapper">

            <span class="wc-latest-news__badge">
              {{ featured_label }}
            </span>

          </div>

        {% endif %}

        <h3 class="wc-latest-news__featured-title">

          {% if featured_url %}

            <a href="{{ featured_url }}">
              {{ featured_title }}
            </a>

          {% else %}

            {{ featured_title }}

          {% endif %}

        </h3>

        {% if featured_date %}

          <div class="wc-latest-news__featured-date">
            {{ featured_date }}
          </div>

        {% endif %}

        {% if featured_summary %}

          <div class="wc-latest-news__featured-summary">
            {{ featured_summary }}
          </div>

        {% endif %}

        {% if featured_url %}

          <a
            href="{{ featured_url }}"
            class="wc-latest-news__read-more"
          >
            Read full story
            <span aria-hidden="true">›</span>
          </a>

        {% endif %}

      </div>

    </article>

  {% endif %}

  <div class="wc-latest-news__list">

    {% for item in news_items %}

      {% if item.title %}

        <article class="wc-latest-news__item">

          <div class="wc-latest-news__item-content">

            {% if item.date %}

              <div class="wc-latest-news__item-date">
                {{ item.date }}
              </div>

            {% endif %}

            {% if item.url %}

              <a
                href="{{ item.url }}"
                class="wc-latest-news__item-title"
              >
                {{ item.title }}
              </a>

            {% else %}

              <div class="wc-latest-news__item-title">
                {{ item.title }}
              </div>

            {% endif %}

          </div>

          {% if item.url %}

            <span
              class="wc-latest-news__item-arrow"
              aria-hidden="true"
            >
              ›
            </span>

          {% endif %}

        </article>

      {% endif %}

    {% endfor %}

  </div>

</section>