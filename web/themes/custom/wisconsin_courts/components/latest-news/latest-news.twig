{#
/**
 * @file
 * Wisconsin Courts - Latest News and Opinions
 */
#}

{% set heading = heading|default('Latest news and opinions') %}
{% set default_tab = default_tab|default('news') %}
{% set items = items|default([]) %}

{% set initial_items = [] %}

{% for item in items %}

  {% if
    default_tab == 'both'
    or (default_tab == 'news' and item.type == 'news')
    or (default_tab == 'opinions' and item.type == 'opinion')
  %}

    {% set initial_items = initial_items|merge([item]) %}

  {% endif %}

{% endfor %}

{% set view_all_text = 'View all news' %}
{% set view_all_url = '/news' %}

{% if default_tab == 'opinions' %}
  {% set view_all_text = 'View all opinions' %}
  {% set view_all_url = '/opinions' %}
{% endif %}


<section
  class="wc-latest-news"
  data-wc-latest-news
  data-default-tab="{{ default_tab }}"
>

  <h2 class="wc-latest-news__heading">
    {{ heading }}
  </h2>


  <div class="wc-latest-news__nav">

    <div
      class="wc-latest-news__tabs"
      role="tablist"
      aria-label="News categories"
    >

      <button
        type="button"
        class="wc-latest-news__tab{{ default_tab == 'news' ? ' wc-latest-news__tab--active' : '' }}"
        role="tab"
        aria-selected="{{ default_tab == 'news' ? 'true' : 'false' }}"
        data-news-tab="news"
      >
        News
      </button>

      <button
        type="button"
        class="wc-latest-news__tab{{ default_tab == 'opinions' ? ' wc-latest-news__tab--active' : '' }}"
        role="tab"
        aria-selected="{{ default_tab == 'opinions' ? 'true' : 'false' }}"
        data-news-tab="opinions"
      >
        Opinions
      </button>

      <button
        type="button"
        class="wc-latest-news__tab{{ default_tab == 'both' ? ' wc-latest-news__tab--active' : '' }}"
        role="tab"
        aria-selected="{{ default_tab == 'both' ? 'true' : 'false' }}"
        data-news-tab="both"
      >
        Both
      </button>

    </div>


    <a
      href="{{ view_all_url }}"
      class="wc-latest-news__view-all"
      data-news-view-all
    >
      {{ view_all_text }}
      <span aria-hidden="true">›</span>
    </a>

  </div>


  <div
    class="wc-latest-news__results"
    data-news-results
    aria-live="polite"
  >

    {% if initial_items|length %}

      {% set featured = initial_items|first %}

      <article class="wc-latest-news__featured">

        {% if featured.image %}

          <div class="wc-latest-news__featured-image-wrapper">

            <img
              src="{{ featured.image }}"
              alt="{{ featured.image_alt|default('') }}"
              class="wc-latest-news__featured-image"
            >

          </div>

        {% endif %}


        <div class="wc-latest-news__featured-content">

          <div class="wc-latest-news__badge-wrapper">

            <span class="wc-latest-news__badge">

              {% if featured.type == 'opinion' %}
                Featured Opinion
              {% else %}
                Featured News
              {% endif %}

            </span>

          </div>


          <h3 class="wc-latest-news__featured-title">

            {% if featured.url %}

              <a href="{{ featured.url }}">
                {{ featured.title }}
              </a>

            {% else %}

              {{ featured.title }}

            {% endif %}

          </h3>


          {% if featured.case_number %}

            <div class="wc-latest-news__case-number">
              {{ featured.case_number }}
            </div>

          {% endif %}


          {% if featured.date %}

            <div class="wc-latest-news__featured-date">
              {{ featured.date }}
            </div>

          {% endif %}


          {% if featured.summary %}

            <div class="wc-latest-news__featured-summary">
              {{ featured.summary }}
            </div>

          {% endif %}


          {% if featured.url %}

            <a
              href="{{ featured.url }}"
              class="wc-latest-news__read-more"
            >

              {% if featured.type == 'opinion' %}
                View opinion
              {% else %}
                Read full story
              {% endif %}

              <span aria-hidden="true">›</span>

            </a>

          {% endif %}

        </div>

      </article>


      <div class="wc-latest-news__list">

        {% for item in initial_items|slice(1, 3) %}

          <article class="wc-latest-news__item">

            <div class="wc-latest-news__item-content">

              {% if item.date %}

                <div class="wc-latest-news__item-date">
                  {{ item.date }}
                </div>

              {% endif %}


              {% if item.case_number %}

                <div class="wc-latest-news__item-case-number">
                  {{ item.case_number }}
                </div>

              {% endif %}


              {% if item.url %}

                <a
                  href="{{ item.url }}"
                  class="wc-latest-news__item-title"
                >
                  {{ item.title }}
                </a>

              {% else %}

                <div class="wc-latest-news__item-title">
                  {{ item.title }}
                </div>

              {% endif %}

            </div>


            {% if item.url %}

              <span
                class="wc-latest-news__item-arrow"
                aria-hidden="true"
              >
                ›
              </span>

            {% endif %}

          </article>

        {% endfor %}

      </div>


    {% else %}

      <p class="wc-latest-news__empty">
        No items are currently available.
      </p>

    {% endif %}

  </div>


  <div class="wc-latest-news__data" hidden>

    {% for item in items %}

      <div
        data-news-item
        data-type="{{ item.type|e('html_attr') }}"
        data-title="{{ item.title|e('html_attr') }}"
        data-date="{{ item.date|default('')|e('html_attr') }}"
        data-summary="{{ item.summary|default('')|e('html_attr') }}"
        data-url="{{ item.url|default('')|e('html_attr') }}"
        data-image="{{ item.image|default('')|e('html_attr') }}"
        data-image-alt="{{ item.image_alt|default('')|e('html_attr') }}"
        data-case-number="{{ item.case_number|default('')|e('html_attr') }}"
      ></div>

    {% endfor %}

  </div>

</section>