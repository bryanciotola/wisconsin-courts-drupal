
{#
/**
 * @file
 * Wisconsin Courts - News Story node template.
 *
 * Displays individual News story pages.
 *
 * Image management:
 * - Featured image is stored as a Media reference.
 * - Image captions are stored on the News story.
 * - Image layout determines how the image is displayed.
 *
 * Supported image layouts:
 * - hero_image: Large image above the article.
 * - right_side_image: Image beside the article introduction.
 */
#}


{# =========================================================
   PUBLICATION DATE
   ========================================================= #}

{% set publication_date = '' %}

{% if node.field_publication_date.value %}

  {% set publication_date =
    node.field_publication_date.value|date(
      'F j, Y',
      'America/Chicago'
    )
  %}

{% endif %}


{# =========================================================
   FEATURED IMAGE
   ========================================================= #}

{% set image_url = '' %}
{% set image_alt = '' %}
{% set image_caption = '' %}

{# Retrieve the Media entity attached to the News story. #}

{% if
  node.field_featured_media is not empty
  and node.field_featured_media.entity
%}

  {% set media = node.field_featured_media.entity %}

  {# Retrieve the image file and alternative text. #}

  {% if
    media.field_media_image is not empty
    and media.field_media_image.entity
  %}

    {% set image_url =
      file_url(media.field_media_image.entity.uri.value)
    %}

    {% set image_alt =
      media.field_media_image.alt|default('')
    %}

  {% endif %}

{% endif %}


{# Retrieve the article-specific image caption. #}

{% if node.field_image_caption.value %}

  {% set image_caption =
    node.field_image_caption.value
  %}

{% endif %}


{# =========================================================
   IMAGE LAYOUT

   The PIO selects the layout when editing the News story.

   hero_image       = Large hero image
   right_side_image = Right-side image

   Right-side is the default for new stories.
   ========================================================= #}

{% set image_layout =
  node.field_image_layout.value|default('right_side_image')
%}


{# =========================================================
   BODY CONTENT
   ========================================================= #}

{% set body_content = content.field_body|default([]) %}

{% if body_content %}

  {% set body_content = body_content|merge({
    '#label_display': 'hidden'
  }) %}

{% endif %}


{# =========================================================
   NEWS STORY LAYOUT
   ========================================================= #}

<article{{ attributes.addClass('wc-news-story') }}>

  <div class="wc-news-story__site-container">

    <div class="wc-news-story__article">


      {# =====================================================
         HERO IMAGE LAYOUT

         Display the featured image above the article
         when the PIO selects "Hero image".
         ===================================================== #}

      {% if image_url and image_layout == 'hero_image' %}

        <figure class="wc-news-story__hero">

          <img
            src="{{ image_url }}"
            alt="{{ image_alt }}"
            class="wc-news-story__hero-image"
          >

          {% if image_caption %}

            <figcaption class="wc-news-story__caption">
              {{ image_caption }}
            </figcaption>

          {% endif %}

        </figure>

      {% endif %}


      {# =====================================================
         ARTICLE INTRO

         The right-side layout places the image beside the
         article heading and introduction.

         The hero layout displays the image above instead.
         ===================================================== #}

      <div class="wc-news-story__intro{{ image_url and image_layout == 'right_side_image' ? ' wc-news-story__intro--with-image' : '' }}">


        {# ---------------------------------------------------
           RIGHT-SIDE IMAGE LAYOUT
           --------------------------------------------------- #}

        {% if image_url and image_layout == 'right_side_image' %}

          <figure class="wc-news-story__right-image">

            <img
              src="{{ image_url }}"
              alt="{{ image_alt }}"
            >

            {% if image_caption %}

              <figcaption class="wc-news-story__caption">
                {{ image_caption }}
              </figcaption>

            {% endif %}

          </figure>

        {% endif %}


        {# ---------------------------------------------------
           ARTICLE HEADER
           --------------------------------------------------- #}

        <header class="wc-news-story__header">

          {% if label %}

            <h1 class="wc-news-story__title">
              {{ label }}
            </h1>

          {% endif %}


          {# Publication date #}

          {% if publication_date %}

            <div class="wc-news-story__date">
              {{ publication_date }}
            </div>

          {% endif %}


          {# Preview text (field_summary). #}

          {% if node.field_summary.value %}

            <div class="wc-news-story__summary">
              {{ node.field_summary.value }}
            </div>

          {% endif %}

        </header>

      </div>


      {# =====================================================
         ARTICLE BODY
         ===================================================== #}

      {% if body_content %}

        <div class="wc-news-story__body">
          {{ body_content }}
        </div>

      {% endif %}


      {# =====================================================
         BACK TO NEWS
         ===================================================== #}

      <div class="wc-news-story__back">

        <a
          href="/news"
          class="wc-news-story__back-link"
        >
          <span aria-hidden="true">‹</span>
          Back to current headlines
        </a>

      </div>


    </div>

  </div>

</article>
