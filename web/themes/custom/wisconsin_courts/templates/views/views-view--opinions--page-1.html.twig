
{#
/**
 * @file
 * Wisconsin Courts - Opinions listing page.
 *
 * Supports an uploaded PDF through Drupal Media or an Opinion URL.
 */
#}

<div class="wc-opinions-listing">

  <div class="wc-opinions-listing__container">

    <header class="wc-opinions-listing__header">

      <h1 class="wc-opinions-listing__heading">
        Opinions
      </h1>

      <p class="wc-opinions-listing__intro">
        Published opinions from the Wisconsin Court System.
      </p>

    </header>


    <div class="wc-opinions-listing__items">

      {% for row in view.result %}

        {% set node = attribute(row, '_entity')|default(null) %}

        {% if node %}

          {% set publication_date = '' %}
          {% set opinion_url = '' %}
          {% set opinion_link_text = 'View opinion' %}


          {# Publication date. #}

          {% if node.field_publication_date.value %}

            {% set publication_date =
              node.field_publication_date.value|date(
                'F j, Y',
                'America/Chicago'
              )
            %}

          {% endif %}


          {# Option 1: An uploaded document stored in Drupal Media. #}

          {% if
            node.field_opinion_document is not empty
            and node.field_opinion_document.entity
          %}

            {% set document_media =
              node.field_opinion_document.entity
            %}

            {% if
              document_media.hasField('field_media_document')
              and document_media.field_media_document is not empty
              and document_media.field_media_document.entity
            %}

              {% set opinion_url =
                file_url(
                  document_media.field_media_document.entity.uri.value
                )
              %}

            {% endif %}

          {% endif %}


          {# Option 2: An internal or external URL. #}

          {% if
            not opinion_url
            and node.field_opinion_url is not empty
          %}

            {% set opinion_url =
              node.field_opinion_url.0.getUrl().toString()
            %}

            {% set custom_link_text =
              node.field_opinion_url.0.title|default('')
            %}

            {% if custom_link_text %}
              {% set opinion_link_text = custom_link_text %}
            {% endif %}

          {% endif %}


          <article class="wc-opinions-listing__item">

            {% if publication_date %}

              <div class="wc-opinions-listing__date">
                {{ publication_date }}
              </div>

            {% endif %}


            <h2 class="wc-opinions-listing__title">

              {% if opinion_url %}

                <a href="{{ opinion_url }}">
                  {{ node.label() }}
                </a>

              {% else %}

                {{ node.label() }}

              {% endif %}

            </h2>


            {% if node.field_case_number.value %}

              <div class="wc-opinions-listing__number">
                {{ node.field_case_number.value }}
              </div>

            {% endif %}


            {% if node.field_summary.value %}

              <p class="wc-opinions-listing__summary">
                {{ node.field_summary.value }}
              </p>

            {% endif %}


            {% if opinion_url %}

              <a
                href="{{ opinion_url }}"
                class="wc-opinions-listing__pdf-link"
              >
                {{ opinion_link_text }}
                <span aria-hidden="true">›</span>
              </a>

            {% endif %}

          </article>

        {% endif %}

      {% else %}

        <p class="wc-opinions-listing__empty">
          No opinions are currently available.
        </p>

      {% endfor %}

    </div>


    {% if pager %}

      <div class="wc-opinions-listing__pager">
        {{ pager }}
      </div>

    {% endif %}

  </div>

</div>
