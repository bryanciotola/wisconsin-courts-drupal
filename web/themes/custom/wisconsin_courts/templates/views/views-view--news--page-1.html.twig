
{#
/**
 * @file
 * Wisconsin Courts - News listing page.
 *
 * Displays News stories in a listing format.
 *
 * Images are managed through Drupal Media:
 *
 * News story (field_featured_media)
 *   -> Image Media entity (field_media_image)
 *     -> Image file
 *
 * The listing uses the Featured image as a thumbnail,
 * regardless of the story's selected image layout.
 */
#}

<div class="wc-news-listing">

  <div class="wc-news-listing__container">

    {# =====================================================
       PAGE HEADER
       ===================================================== #}

    <header class="wc-news-listing__header">

      <h1 class="wc-news-listing__heading">
        News
      </h1>

      <p class="wc-news-listing__intro">
        News, announcements, and updates from the Wisconsin Court System.
      </p>

    </header>


    {# =====================================================
       NEWS STORIES
       ===================================================== #}

    <div class="wc-news-listing__items">

      {% for row in view.result %}

        {% set node = attribute(row, '_entity')|default(null) %}

        {% if node %}

          {# Default values. #}

          {% set publication_date = '' %}
          {% set image_url = '' %}


          {# -------------------------------------------------
             PUBLICATION DATE
             ------------------------------------------------- #}

          {% if node.field_publication_date.value %}

            {% set publication_date =
              node.field_publication_date.value|date(
                'F j, Y',
                'America/Chicago'
              )
            %}

          {% endif %}


          {# -------------------------------------------------
             FEATURED IMAGE

             Retrieve the Media entity referenced by the
             News story, then retrieve its image file.
             ------------------------------------------------- #}

          {% if
            node.field_featured_media is not empty
            and node.field_featured_media.entity
          %}

            {% set media = node.field_featured_media.entity %}

            {% if
              media.field_media_image is not empty
              and media.field_media_image.entity
            %}

              {% set image_url =
                file_url(media.field_media_image.entity.uri.value)
              %}

            {% endif %}

          {% endif %}


          {# -------------------------------------------------
             STORY URL
             ------------------------------------------------- #}

          {% set story_url =
            path(
              'entity.node.canonical',
              {
                node: node.id()
              }
            )
          %}


          {# =================================================
             NEWS STORY ITEM
             ================================================= #}

          <article class="wc-news-listing__item{{ image_url ? ' wc-news-listing__item--with-image' : '' }}">


            {# -----------------------------------------------
               IMAGE THUMBNAIL

               Decorative because the linked headline
               already identifies the article.
               ----------------------------------------------- #}

            {% if image_url %}

              <div class="wc-news-listing__image-wrapper">

                <a
                  href="{{ story_url }}"
                  class="wc-news-listing__image-link"
                  tabindex="-1"
                  aria-hidden="true"
                >

                  <img
                    src="{{ image_url }}"
                    alt=""
                    class="wc-news-listing__image"
                    loading="lazy"
                  >

                </a>

              </div>

            {% endif %}


            {# -----------------------------------------------
               STORY CONTENT
               ----------------------------------------------- #}

            <div class="wc-news-listing__content">


              {# Publication date #}

              {% if publication_date %}

                <div class="wc-news-listing__date">
                  {{ publication_date }}
                </div>

              {% endif %}


              {# News story title #}

              <h2 class="wc-news-listing__title">

                <a href="{{ story_url }}">
                  {{ node.label() }}
                </a>

              </h2>


              {#
                Preview text.

                The field is labeled "Preview" in Drupal,
                but its machine name is field_summary.
              #}

              {% if node.field_summary.value %}

                <p class="wc-news-listing__summary">
                  {{ node.field_summary.value }}
                </p>

              {% endif %}


              {# Read more link #}

              <a
                href="{{ story_url }}"
                class="wc-news-listing__read-more"
              >
                Read more
                <span aria-hidden="true">›</span>
              </a>


            </div>

          </article>

        {% endif %}

      {% else %}

        <p class="wc-news-listing__empty">
          No news stories are currently available.
        </p>

      {% endfor %}

    </div>


    {# =====================================================
       PAGINATION
       ===================================================== #}

    {% if pager %}

      <div class="wc-news-listing__pager">
        {{ pager }}
      </div>

    {% endif %}

  </div>

</div>
