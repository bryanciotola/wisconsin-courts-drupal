
{#
/**
 * @file
 * Homepage News and Opinions View.
 *
 * Converts News story and Opinion nodes from the Drupal View
 * into the item structure expected by the Latest News component.
 *
 * News images are managed through Drupal Media:
 *
 * News story (field_featured_media)
 *   -> Image Media entity (field_media_image)
 *     -> File entity
 *
 * Image captions are stored in field_image_caption.
 *
 * Opinion documents can come from:
 *
 * 1. An uploaded PDF through Document Media.
 * 2. An internal or external URL.
 */
#}

{% set news_items = [] %}

{% for row in view.result %}

  {% set node = attribute(row, '_entity')|default(null) %}

  {% if node %}

    {% set bundle = node.bundle() %}


    {# ======================================================
       NEWS STORY
       ====================================================== #}

    {% if bundle == 'news_story' %}

      {# Default values when no image is available. #}
      {% set image_url = '' %}
      {% set image_alt = '' %}


      {# ----------------------------------------------------
         FEATURED IMAGE

         Retrieve the Media entity referenced by the News
         story, then retrieve the image file from that Media.
         ---------------------------------------------------- #}

      {% if
        node.field_featured_media is not empty
        and node.field_featured_media.entity
      %}

        {% set media = node.field_featured_media.entity %}

        {% if
          media.field_media_image is not empty
          and media.field_media_image.entity
        %}

          {% set image_url =
            file_url(media.field_media_image.entity.uri.value)
          %}

          {% set image_alt =
            media.field_media_image.alt|default('')
          %}

        {% endif %}

      {% endif %}


      {# ----------------------------------------------------
         PUBLICATION DATE

         Format the publication date for display.
         Example: October 13, 2026
         ---------------------------------------------------- #}

      {% set publication_date = '' %}

      {% if node.field_publication_date.value %}

        {% set publication_date =
          node.field_publication_date.value|date(
            'F j, Y',
            'America/Chicago'
          )
        %}

      {% endif %}


      {# ----------------------------------------------------
         BUILD NEWS ITEM

         Convert the News story into the structure expected
         by the Latest News component.

         field_summary is labeled "Preview" in Drupal.
         ---------------------------------------------------- #}

      {% set news_items = news_items|merge([
        {
          type: 'news',
          title: node.label(),
          date: publication_date,
          summary: node.field_summary.value|default(''),
          url: path(
            'entity.node.canonical',
            {
              node: node.id()
            }
          ),
          image: image_url,
          image_alt: image_alt,
          case_number: '',
          label: 'News'
        }
      ]) %}


    {# ======================================================
       OPINION
       ====================================================== #}

    {% elseif bundle == 'opinion' %}


      {# ----------------------------------------------------
         OPINION DOCUMENT

         Retrieve an uploaded PDF through Drupal Media.

         Opinion (field_opinion_document)
           -> Document Media (field_media_document)
             -> File entity
         ---------------------------------------------------- #}

      {% set opinion_url = '' %}

      {% if
        node.field_opinion_document is not empty
        and node.field_opinion_document.entity
      %}

        {% set document_media =
          node.field_opinion_document.entity
        %}

        {% if
          document_media.hasField('field_media_document')
          and document_media.field_media_document is not empty
          and document_media.field_media_document.entity
        %}

          {% set opinion_url =
            file_url(
              document_media.field_media_document.entity.uri.value
            )
          %}

        {% endif %}

      {% endif %}


      {# ----------------------------------------------------
         OPINION URL

         If there is no uploaded document, use the internal
         or external URL provided by the editor.
         ---------------------------------------------------- #}

      {% if
        not opinion_url
        and node.field_opinion_url is not empty
      %}

        {% set opinion_url =
          node.field_opinion_url.0.getUrl().toString()
        %}

      {% endif %}


      {# ----------------------------------------------------
         PUBLICATION DATE
         ---------------------------------------------------- #}

      {% set publication_date = '' %}

      {% if node.field_publication_date.value %}

        {% set publication_date =
          node.field_publication_date.value|date(
            'F j, Y',
            'America/Chicago'
          )
        %}

      {% endif %}


      {# ----------------------------------------------------
         BUILD OPINION ITEM

         Opinions do not use featured images.

         The URL points to either an uploaded PDF or
         the internal/external link provided by the editor.
         ---------------------------------------------------- #}

      {% set news_items = news_items|merge([
        {
          type: 'opinion',
          title: node.label(),
          date: publication_date,
          summary: node.field_summary.value|default(''),
          url: opinion_url,
          image: '',
          image_alt: '',
          case_number: node.field_case_number.value|default(''),
          label: 'Opinion'
        }
      ]) %}

    {% endif %}

  {% endif %}

{% endfor %}


{# ========================================================
   RENDER LATEST NEWS COMPONENT

   Pass the prepared items into our existing SDC.
   ======================================================== #}

{% include 'wisconsin_courts:latest-news' with {
  heading: 'Latest news and opinions',
  default_tab: 'news',
  all_news_text: 'View all',
  all_news_url: '/news',
  items: news_items
} only %}
