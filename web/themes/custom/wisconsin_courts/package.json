{
  "name": "wisconsin-courts",
  "version": "1.0.0",
  "description": "Wisconsin Courts Drupal theme assets",
  "license": "ISC",
  "private": true,
  "scripts": {
    "build": "gulp",
    "build:uswds:init": "gulp init",
    "build:uswds:update": "gulp updateUswds",
    "build:css": "gulp compileCss",
    "build:js": "gulp compileJs",
    "build:all": "gulp compileAll",
    "watch": "gulp watch",
    "lint:css": "stylelint \"sass/**/*.scss\" \"css/**/*.css\" \"components/**/*.css\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "postinstall": "patch-package",
    "check:css": "node scripts/check-css.cjs"
  },
  "paths": {
    "dist": {
      "assets": "./assets",
      "uswds": "./assets/uswds",
      "css": "./assets/css",
      "js": "./assets/js",
      "img": "./images"
    },
    "scss": [
      "./sass/**/*.scss"
    ],
    "js": [
      "./js/**/*.js"
    ]
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@uswds/compile": "^1.2.1",
    "autoprefixer": "^10.4.13",
    "del": "^8.0.0",
    "eslint": "^9.37.0",
    "eslint-config-airbnb-extended": "^2.3.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-yml": "^1.14.0",
    "globals": "^16.4.0",
    "gulp": "^5.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.0",
    "gulp-uglify-es": "^3.0.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.6.2",
    "sass": "^1.50.0",
    "sass-embedded": "^1.58.0",
    "stylelint": "^16.3.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^6.2.0"
  },
  "dependencies": {
    "@uswds/uswds": "^3.13.0"
  },
  "optionalDependencies": {
    "sass-embedded-linux-x64": "^1.93.0"
  }
}
